      "file": "native/obligation/obligation.go",
      "original": "case u.Path == \"/clerk/time\", u.Path == \"/bor/spans/latest\", u.Path == \"/status\":",
      "replacement": "case u.Path == \"/bor/spans/latest\", u.Path == \"/status\":"
