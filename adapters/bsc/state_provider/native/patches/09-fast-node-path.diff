+
+// extractorFlushState makes the state of root persistent before the intent
+// of a decision. Under the hash scheme it is the commit of the root from the
+// trie cache. Under the path scheme (D108) it is the full commit of the path
+// store, which a capture node waits for: it disallows the asynchronous
+// flush, so the state is on the key-value store when the commit returns. A
+// root that already is the persistent layer is not committed again, because
+// a block whose state root equals its parent's adds no layer and the commit
+// would fail. The persistent state id must then name the root, or the state
+// is not durable.
+func (bc *BlockChain) extractorFlushState(root common.Hash) error {
+	if bc.triedb.Scheme() != rawdb.PathScheme {
+		return bc.triedb.Commit(root, false)
+	}
+	if id := rawdb.ReadStateID(bc.db, root); id != nil && *id == rawdb.ReadPersistentStateID(bc.db) {
+		return nil
+	}
+	if err := bc.triedb.Commit(root, false); err != nil {
+		return err
+	}
+	if id := rawdb.ReadStateID(bc.db, root); id == nil || *id != rawdb.ReadPersistentStateID(bc.db) {
+		return fmt.Errorf("%w: state %x is not the persistent state after its commit", ErrExtractorDecision, root)
+	}
+	return nil
+}
+
+// extractorRecoverHeadState runs before the native startup repair. The
+// child-root barrier commits the state of the block being decided before
+// that block becomes the head, so a crash between the barrier and the head
+// batch leaves the persistent layer of the path store above the head. The
+// native repair would search the chain below the head for the persistent
+// root, find no block with it and reach genesis. When the store holds the
+// state id of the head below the persistent state id, the persistent layer
+// is rolled back to the state of the head through the state histories, as
+// the native rewind does. The decision recovery of the capture node then
+// replays the undecided block. A head whose state cannot be rebuilt stops
+// the node instead.
+func (bc *BlockChain) extractorRecoverHeadState(head *types.Header) error {
+	if bc.triedb.Scheme() != rawdb.PathScheme || bc.NoTries() || bc.HasState(head.Root) {
+		return nil
+	}
+	id := rawdb.ReadStateID(bc.db, head.Root)
+	if id == nil || *id >= rawdb.ReadPersistentStateID(bc.db) {
+		return nil
+	}
+	if recoverable, err := bc.triedb.Recoverable(head.Root); err != nil || !recoverable {
+		return fmt.Errorf("extractor: the persistent state is above the head %d and the state %x of the head cannot be rebuilt",
+			head.Number, head.Root)
+	}
+	if err := bc.triedb.Recover(head.Root); err != nil {
+		return fmt.Errorf("extractor: rollback of the persistent state to the head %d: %v", head.Number, err)
+	}
+	log.Info("Extractor: rolled the persistent state back to the head", "number", head.Number, "hash", head.Hash(),
+		"root", head.Root)
+	return nil
+}
