+// The capture adapter (extractor/bsc/lifecycle) implements
+// ExtractorLifecycle; core cannot import it. With a seam installed, every
+// mapped native caller opens a gate pass with the observation guard held,
+// every native write choke point calls Require before it mutates, and the
+// head and finality changes without a new block are decisions: an intent
+// before the native mutation and the marker in its final native batch.
+
+package core
+
+import (
+	"errors"
+	"fmt"
+
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/core/rawdb"
+	"github.com/ethereum/go-ethereum/core/types"
+	"github.com/ethereum/go-ethereum/ethdb"
+	"github.com/ethereum/go-ethereum/log"
+)
+
+// ExtractorLifecycle is the lifecycle gate seam of E01-02.lifecycle_seams.
+// Every method except Require and Refuse runs with the observation guard
+// held by the caller.
+type ExtractorLifecycle interface {
+	// Enter opens the gate pass of the mapped caller id; exit closes it.
+	Enter(id string) (exit func(), err error)
+	// Observing reports whether the innermost pass captures: false during
+	// the initial native sync (BOOTSTRAP), where imports are not observed.
+	Observing() bool
+	// Require is the check of a native write choke point before a mutation
+	// with this effect (EXECUTION, CANONICAL, FINALITY). An error means the
+	// mutation bypassed the gate; the write must fail closed.
+	Require(effect string) error
+	// Refuse takes the guard and refuses a REFUSE caller of the capture
+	// profile; it returns the refusal.
+	Refuse(id string) error
+	// Canonical records the CANONICAL intent of the innermost decision pass
+	// for a head change from old to head without a new execution. A pass
+	// that does not observe records nothing.
+	Canonical(old, head *types.Header) error
+	// Rewind records the CANONICAL intent of a SetHead rewind from old to
+	// target, the head that the native rewind keeps.
+	Rewind(old, target *types.Header) error
+	// Rewinding reports whether a SetHead rewind is in progress.
+	Rewinding() bool
+	// Rewound checks the rewound head against the intent and returns the
+	// marker and view records of the rewind batch.
+	Rewound(head *types.Header, finalized common.Hash) ([][]byte, error)
+	// Clear records the FINALITY intent of a finality clear (the native
+	// SetFinalized(nil) of a rewind) and returns its marker and view records.
+	Clear(old, head *types.Header) ([][]byte, error)
+	// Shutdown records the CANONICAL intent of the head rewrite of Stop and
+	// returns its marker and view records.
+	Shutdown(head *types.Header, finalized common.Hash) ([][]byte, error)
+	// View returns the key and value of the lifecycle view record: the head
+	// and the finalized block hash that the decided native state holds.
+	View(head *types.Header, finalized common.Hash) [][]byte
+	// Settle resolves the pending lifecycle decision after its batch is
+	// durable, or, after a native error, rejects an intent whose mutation
+	// did not happen. It returns err joined with any settle error.
+	Settle(err error) error
+}
+
+// ErrExtractorReset refuses a chain reset on a capture store: it would drop
+// the canonical chain with no decision.
+var ErrExtractorReset = errors.New("extractor: a chain reset is refused on a capture store")
+
+// ErrExtractorWitness refuses an execution without a state write (the
+// execution witness RPC) on a capture node: it would run outside the
+// observation guard and read through the current observation.
+var ErrExtractorWitness = errors.New("extractor: execution without a state write is refused on a capture node")
+
+// SetExtractorLifecycle installs the lifecycle gate seam. It must be called
+// before the first import.
+func (bc *BlockChain) SetExtractorLifecycle(l ExtractorLifecycle) { bc.extractorLifecycle = l }
+
+// extractorLock takes the observation guard of the installed hook, if any.
+// The lock order is guard, then chainmu.
+func (bc *BlockChain) extractorLock() func() {
+	if hook := bc.extractorHookValue(); hook != nil {
+		return hook.Acquire()
+	}
+	return func() {}
+}
+
+// extractorEnter opens the pass of a mapped caller if a seam is installed.
+// The guard is held.
+func (bc *BlockChain) extractorEnter(id string) (func(), error) {
+	if bc.extractorLifecycle == nil {
+		return func() {}, nil
+	}
+	return bc.extractorLifecycle.Enter(id)
+}
+
+// extractorObserving reports whether an import of the current pass is
+// observed by the admission seam.
+func (bc *BlockChain) extractorObserving() bool {
+	return bc.extractorLifecycle == nil || bc.extractorLifecycle.Observing()
+}
+
+// extractorRequire is the check of a write choke point.
+func (bc *BlockChain) extractorRequire(effect string) error {
+	if bc.extractorLifecycle == nil {
+		return nil
+	}
+	return bc.extractorLifecycle.Require(effect)
+}
+
+// ExtractorRefuse refuses a REFUSE caller of the capture profile (the
+// Engine API, snap sync, sealing) when a seam is installed. It takes the
+// guard, so it must be called before the chain mutex.
+func (bc *BlockChain) ExtractorRefuse(id string) error {
+	if bc.extractorLifecycle == nil {
+		return nil
+	}
+	return bc.extractorLifecycle.Refuse(id)
+}
+
+// extractorSettle resolves or rejects the pending lifecycle decision.
+func (bc *BlockChain) extractorSettle(err error) error {
+	if bc.extractorLifecycle == nil {
+		return err
+	}
+	return bc.extractorLifecycle.Settle(err)
+}
+
+// extractorFinalizedHash is the finalized block hash of the native store.
+func (bc *BlockChain) extractorFinalizedHash() common.Hash {
+	return rawdb.ReadFinalizedBlockHash(bc.db)
+}
+
+// extractorWriteRecords writes records (key, value pairs) and the native
+// writes of fill in one batch, and syncs when records are present.
+func (bc *BlockChain) extractorWriteRecords(records [][]byte, fill func(batch ethdb.KeyValueWriter)) error {
+	batch := bc.db.NewBatch()
+	defer batch.Close()
+	if fill != nil {
+		fill(batch)
+	}
+	for i := 0; i+1 < len(records); i += 2 {
+		if err := batch.Put(records[i], records[i+1]); err != nil {
+			return err
+		}
+	}
+	if err := batch.Write(); err != nil {
+		return err
+	}
+	if len(records) == 0 {
+		return nil
+	}
+	return bc.db.SyncKeyValue()
+}
+
+// extractorKnownBlock is the CANONICAL decision of a stored block that
+// becomes the head without an execution (bsc.known-block). It returns the
+// end of the pass, which settles the decision.
+func (bc *BlockChain) extractorKnownBlock(block *types.Block) (func(error) error, error) {
+	if bc.extractorLifecycle == nil {
+		return func(err error) error { return err }, nil
+	}
+	exit, err := bc.extractorLifecycle.Enter("bsc.known-block")
+	if err != nil {
+		return nil, err
+	}
+	if err := bc.extractorLifecycle.Canonical(bc.CurrentBlock(), block.Header()); err != nil {
+		exit()
+		return nil, err
+	}
+	return func(err error) error {
+		err = bc.extractorLifecycle.Settle(err)
+		exit()
+		return err
+	}, nil
+}
+
+// extractorRewindTarget is the head that a rewind to head (or, with time,
+// to the newest header at or below time) keeps: the native rewindHead of the
+// target, which reads only.
+func (bc *BlockChain) extractorRewindTarget(head, time uint64) *types.Header {
+	header := bc.CurrentBlock()
+	if time > 0 {
+		for header != nil && header.Number.Uint64() > 0 && header.Time > time {
+			header = bc.GetHeader(header.ParentHash, header.Number.Uint64()-1)
+		}
+	} else if head < header.Number.Uint64() {
+		header = bc.GetHeaderByNumber(head)
+	}
+	if header == nil {
+		return nil
+	}
+	target, _ := bc.rewindHead(header, common.Hash{})
+	return target
+}
+
+// extractorBeginRewind opens the pass of a SetHead rewind (bsc.set-head)
+// and records its CANONICAL intent. The returned function settles the
+// decision and closes the pass. The guard is held.
+func (bc *BlockChain) extractorBeginRewind(head, time uint64) (func(error) error, error) {
+	l := bc.extractorLifecycle
+	if l == nil {
+		return func(err error) error { return err }, nil
+	}
+	exit, err := l.Enter("bsc.set-head")
+	if err != nil {
+		return nil, err
+	}
+	if err := l.Rewind(bc.CurrentBlock(), bc.extractorRewindTarget(head, time)); err != nil {
+		exit()
+		return nil, err
+	}
+	return func(err error) error {
+		err = l.Settle(err)
+		exit()
+		return err
+	}, nil
+}
+
+// extractorRewinding reports whether setHeadBeyondRoot runs a decided
+// rewind.
+func (bc *BlockChain) extractorRewinding() bool {
+	return bc.extractorLifecycle != nil && bc.extractorLifecycle.Rewinding()
+}
+
+// extractorFinishRewind ends a decided rewind in setHeadBeyondRoot, in the
+// native order: the rewind batch with its marker, then the finalized clear
+// as its own FINALITY decision, then loadLastState.
+func (bc *BlockChain) extractorFinishRewind() error {
+	l := bc.extractorLifecycle
+	head := bc.CurrentBlock()
+	records, err := l.Rewound(head, bc.extractorFinalizedHash())
+	if err != nil {
+		return err
+	}
+	if err := bc.extractorWriteRecords(records, nil); err != nil {
+		return err
+	}
+	if err := l.Settle(nil); err != nil {
+		return err
+	}
+	if finalized := bc.CurrentFinalBlock(); finalized != nil && head.Number.Uint64() < finalized.Number.Uint64() {
+		log.Error("SetHead invalidated finalized block")
+		records, err := l.Clear(finalized, head)
+		if err != nil {
+			return err
+		}
+		if err := l.Settle(bc.setFinalizedChecked(nil, records)); err != nil {
+			return err
+		}
+	}
+	return bc.loadLastState()
+}
+
+// setFinalizedChecked is the native finalized setter behind the FINALITY
+// choke point: the reference and the records of its decision are written in
+// one batch and synced before the in-memory reference moves. A failed write
+// is fatal, as the native finalized write is.
+func (bc *BlockChain) setFinalizedChecked(header *types.Header, records [][]byte) error {
+	if err := bc.extractorRequire("FINALITY"); err != nil {
+		return err
+	}
+	if err := bc.extractorWriteRecords(records, func(batch ethdb.KeyValueWriter) {
+		if header != nil {
+			rawdb.WriteFinalizedBlockHash(batch, header.Hash())
+		} else {
+			rawdb.WriteFinalizedBlockHash(batch, common.Hash{})
+		}
+	}); err != nil {
+		log.Crit("Failed to write the finalized block and its decision marker", "err", err)
+	}
+	bc.currentFinalBlock.Store(header)
+	return nil
+}
+
+// extractorShutdownHead is the head rewrite of Stop (hash scheme) with a
+// seam: one CANONICAL decision of the head to itself (bsc.shutdown), its
+// marker and view in the batch of the head hash. A rewrite to another block
+// (the state commit of the head failed) is not decided: it is skipped, and
+// the next start repairs and reconciles the head. It takes the guard, after
+// the chain mutex is closed, so no import holds it.
+func (bc *BlockChain) extractorShutdownHead(recent *types.Block) {
+	l := bc.extractorLifecycle
+	if l == nil {
+		rawdb.WriteHeadBlockHash(bc.db, recent.Hash())
+		return
+	}
+	defer bc.extractorLock()()
+	exit, err := l.Enter("bsc.shutdown")
+	if err != nil {
+		log.Error("Extractor lifecycle refused the shutdown head write", "err", err)
+		return
+	}
+	defer exit()
+	head := bc.CurrentBlock()
+	if recent.Hash() != head.Hash() {
+		log.Error("Extractor lifecycle skipped a shutdown head write below the head", "head", head.Number,
+			"recent", recent.Number())
+		return
+	}
+	records, err := l.Shutdown(head, bc.extractorFinalizedHash())
+	if err != nil {
+		log.Error("Extractor lifecycle refused the shutdown head write", "err", err)
+		return
+	}
+	if err := bc.extractorRequire("CANONICAL"); err != nil {
+		log.Error("Extractor lifecycle refused the shutdown head write", "err", l.Settle(err))
+		return
+	}
+	err = bc.extractorWriteRecords(records, func(batch ethdb.KeyValueWriter) {
+		rawdb.WriteHeadBlockHash(batch, recent.Hash())
+	})
+	if err := l.Settle(err); err != nil {
+		log.Error("Extractor lifecycle shutdown decision failed", "err", err)
+	}
+}
+
+// extractorHeadRecords returns the lifecycle view record that joins a head
+// batch carrying a decision marker; nil without a seam or a marker.
+func (bc *BlockChain) extractorHeadRecords(block *types.Block) [][]byte {
+	marker := bc.extractorMarker
+	if bc.extractorLifecycle == nil || marker == nil || marker.block != block.Hash() {
+		return nil
+	}
+	finalized := bc.extractorFinalizedHash()
+	if marker.finalized != nil {
+		finalized = marker.finalized.Hash()
+	}
+	return bc.extractorLifecycle.View(block.Header(), finalized)
+}
+
+// extractorRefusedExecution refuses an execution without a state write on
+// a capture node.
+func (bc *BlockChain) extractorRefusedExecution(config ExecuteConfig) error {
+	if bc.extractorHookValue() != nil && !config.WriteState {
+		return fmt.Errorf("%w", ErrExtractorWitness)
+	}
+	return nil
+}
