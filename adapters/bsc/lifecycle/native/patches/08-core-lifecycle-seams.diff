--- /dev/null
+++ b/cmd/utils/extractor_guard.go
@@ -0,0 +1,28 @@
+// Extractor patch (E01-02.lifecycle_seams, BSC block): the manual database
+// guard of the shipped geth on a capture store (bsc.database-commands).
+
+package utils
+
+import (
+	"github.com/ethereum/go-ethereum/core/rawdb"
+	bsclifecycle "github.com/ethereum/go-ethereum/extractor/bsc/lifecycle"
+	"github.com/ethereum/go-ethereum/node"
+	"github.com/urfave/cli/v2"
+)
+
+// ExtractorGuardChaindata refuses a command that deletes or rewrites
+// chaindata while an extractor pin is live. MakeChainDatabase calls it
+// before every writable open and `geth removedb` before it deletes
+// anything. It opens an existing store read-only with the database flags of
+// ctx, checks it with bsclifecycle.RequireNoOpenCapture and closes it. A
+// directory without a native store passes. The caller holds the instance
+// lock of the native node (makeConfigNode), so no other geth process can
+// add a pin before the command opens the store for writing.
+func ExtractorGuardChaindata(ctx *cli.Context, stack *node.Node) error {
+	if rawdb.PreexistingDatabase(stack.ResolvePath("chaindata")) == "" {
+		return nil
+	}
+	db := MakeChainDatabase(ctx, stack, true)
+	defer db.Close()
+	return bsclifecycle.RequireNoOpenCapture(db)
+}
