--- /dev/null
+++ b/consensus/parlia/extractor_lifecycle.go
@@ -0,0 +1,27 @@
+// Extractor patch (E01-02.lifecycle_seams, BSC block): the error-aware read
+// of the snapshot vote attestation.
+
+package parlia
+
+import (
+	"github.com/ethereum/go-ethereum/consensus"
+	"github.com/ethereum/go-ethereum/core/types"
+)
+
+// ExtractorAttestation returns the vote attestation of the Parlia snapshot
+// of header: nil for a snapshot without one, or the lookup error. Unlike
+// GetJustifiedNumberAndHash and GetFinalizedHeader, it never turns a lookup
+// error into the genesis block or into no result. It reads through chain as
+// the native lookup does (memory cache, stored checkpoint, header walk).
+func (p *Parlia) ExtractorAttestation(chain consensus.ChainHeaderReader, header *types.Header) (*types.VoteData,
+	error) {
+	snap, err := p.snapshot(chain, header.Number.Uint64(), header.Hash(), nil)
+	if err != nil {
+		return nil, err
+	}
+	if snap.Attestation == nil {
+		return nil, nil
+	}
+	att := *snap.Attestation
+	return &att, nil
+}
