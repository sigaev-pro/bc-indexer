index 0000000..01ac673
--- /dev/null
+++ b/core/extractor_hook.go
@@ -0,0 +1,214 @@
+// Extractor patch (E01-02.admission, BSC block): the native import seam.
+//
+// This file is added to the BSC source tree by the extractor patch set. It
+// declares the hook that the capture adapter installs on a BlockChain and the
+// rewind guard of the pin ledger. The core package cannot import the adapter
+// (the adapter imports core), so both are interfaces or function variables.
+
+package core
+
+import (
+	"context"
+	"errors"
+	"fmt"
+
+	"github.com/ethereum/go-ethereum/consensus"
+	"github.com/ethereum/go-ethereum/core/state"
+	"github.com/ethereum/go-ethereum/core/types"
+	"github.com/ethereum/go-ethereum/ethdb"
+)
+
+// ExtractorRewindGuard, when set, runs before every native head rewind
+// (SetHead, SetHeadWithTimestamp, and the startup repair) with the requested
+// head number; an error refuses the rewind. A rewind by timestamp passes 0,
+// so with any pinned header the guard refuses it. The pin ledger sets it from
+// an init function, before any store is opened.
+var ExtractorRewindGuard func(db ethdb.Database, newHead uint64) error
+
+// ErrExtractorUnobserved refuses a block execution that no admitted
+// observation covers while an extractor hook is installed.
+var ErrExtractorUnobserved = errors.New("extractor: block execution outside an admitted observation")
+
+// ErrExtractorParentState marks a native failure of an observed block during
+// which a parent state read failed: the failure may come from the missing
+// state, so it is not an authoritative rejection.
+var ErrExtractorParentState = errors.New("extractor: parent state read failed during execution")
+
+// ExtractorHook admits one native observation per imported block. While a
+// hook is installed, InsertChain takes the observation guard (Acquire) before
+// the chain mutex, imports one block per insertChain call and calls Begin
+// first, with both held.
+type ExtractorHook interface {
+	// Acquire takes the node's observation guard and returns its release.
+	// The lock order is guard, then native locks.
+	Acquire() (release func())
+	// Begin checks the block, pins its parent, seals its static inputs and
+	// admits the observation (or resumes the admitted obligation of the same
+	// block). It returns nil and no error when the block needs no
+	// observation because it is already in the chain with its state. Begin
+	// returns only after the closing ADMITTED sync, so no header
+	// verification, Process or capture hook runs before it.
+	Begin(chain *BlockChain, block *types.Block) (ExtractorObservation, error)
+}
+
+// ExtractorReader is the chain reader of an observation.
+type ExtractorReader interface {
+	consensus.ChainHeaderReader
+	Engine() consensus.Engine
+}
+
+// ExtractorObservation is the admitted observation of one block.
+type ExtractorObservation interface {
+	// Hash is the hash of the observed block.
+	Hash() [32]byte
+	// Reader returns the chain reader of the observation; native is the
+	// chain itself. Header verification, Process, Finalize and BLOCKHASH
+	// read headers only through it, so every header they read is a static
+	// input of the observation. Readers on other goroutines keep the chain.
+	Reader(native ExtractorReader) ExtractorReader
+	// Validated runs after native validation (ValidateState) and before the
+	// state and the block are written. It closes the dependency log and
+	// writes EXEC_READY; an error stops the import before any write.
+	Validated(block *types.Block, statedb *state.StateDB, res *ProcessResult) error
+	// Rejected runs where native validation reports a bad block. It closes
+	// the observation as NATIVE_REJECTED with the rejection evidence.
+	Rejected(block *types.Block, res *ProcessResult, cause error)
+	// End runs after insertChain returns, with its error. It detaches the
+	// observation and returns an error if the observation is still ADMITTED
+	// (the obligation stays for recovery) or if Validated or Rejected failed.
+	End(insertErr error) error
+}
+
+// SetExtractorHook installs hook, or removes it with nil. Install it before
+// the first import; an InsertChain that already read the old value finishes
+// with it.
+func (bc *BlockChain) SetExtractorHook(hook ExtractorHook) {
+	if hook == nil {
+		bc.extractorHook.Store(nil)
+		return
+	}
+	bc.extractorHook.Store(&hook)
+}
+
+// extractorHookValue returns the installed hook, or nil.
+func (bc *BlockChain) extractorHookValue() ExtractorHook {
+	if hook := bc.extractorHook.Load(); hook != nil {
+		return *hook
+	}
+	return nil
+}
+
+// extractorInsert imports chain one block at a time, each inside its own
+// observation. The chain mutex is held.
+//
+// The native data-availability check runs before Begin. insertChain refuses a
+// block that fails it without reportBadBlock, so after Begin the failure would
+// leave an obligation that no exit resolves. Before Begin it is refused with
+// no observation, and the sidecars that Begin saves in the capsule are the
+// checked ones, which recovery attaches again.
+func (bc *BlockChain) extractorInsert(hook ExtractorHook, chain types.Blocks) (int, error) {
+	for index, block := range chain {
+		if bc.chainConfig.IsInBSC() {
+			if err := IsDataAvailable(bc, block); err != nil {
+				return index, err
+			}
+		}
+		observation, err := hook.Begin(bc, block)
+		if err != nil {
+			return index, err
+		}
+		if observation == nil {
+			// Known with state: the native path skips it without execution;
+			// an execution would fail with ErrExtractorUnobserved.
+			if _, _, err := bc.insertChain(context.Background(), types.Blocks{block}, true, false); err != nil {
+				return index, err
+			}
+			continue
+		}
+		bc.extractorObservation = observation
+		_, _, err = bc.insertChain(context.Background(), types.Blocks{block}, true, false)
+		bc.extractorObservation = nil
+		if endErr := observation.End(err); endErr != nil {
+			return index, endErr
+		}
+		if err != nil {
+			return index, err
+		}
+	}
+	return len(chain), nil
+}
+
+// extractorCheckExecution refuses an execution that the current observation
+// does not cover. It is called by ProcessBlock before execution.
+func (bc *BlockChain) extractorCheckExecution(block *types.Block) error {
+	if bc.extractorHookValue() == nil {
+		return nil
+	}
+	if bc.extractorObservation == nil || bc.extractorObservation.Hash() != block.Hash() {
+		return fmt.Errorf("%w: block %d %x", ErrExtractorUnobserved, block.NumberU64(), block.Hash())
+	}
+	return nil
+}
+
+// extractorValidated reports a block that passed native validation.
+func (bc *BlockChain) extractorValidated(block *types.Block, statedb *state.StateDB, res *ProcessResult) error {
+	if bc.extractorObservation == nil {
+		return nil
+	}
+	return bc.extractorObservation.Validated(block, statedb, res)
+}
+
+// extractorRejected reports a block that native validation refused.
+func (bc *BlockChain) extractorRejected(block *types.Block, res *ProcessResult, cause error) {
+	if bc.extractorObservation != nil && bc.extractorObservation.Hash() == block.Hash() {
+		bc.extractorObservation.Rejected(block, res, cause)
+	}
+}
+
+// extractorReader returns the reader of the current observation, or nil.
+func (bc *BlockChain) extractorReader() ExtractorReader {
+	if bc.extractorObservation == nil {
+		return nil
+	}
+	return bc.extractorObservation.Reader(bc)
+}
+
+// extractorReaderKey carries the observation reader into Process.
+type extractorReaderKey struct{}
+
+// extractorContext adds the reader of the current observation to ctx.
+func (bc *BlockChain) extractorContext(ctx context.Context) context.Context {
+	if reader := bc.extractorReader(); reader != nil {
+		return context.WithValue(ctx, extractorReaderKey{}, reader)
+	}
+	return ctx
+}
+
+// extractorChain returns the observation reader that ctx carries, or chain.
+func extractorChain(ctx context.Context, chain *HeaderChain) ExtractorReader {
+	if reader, ok := ctx.Value(extractorReaderKey{}).(ExtractorReader); ok {
+		return reader
+	}
+	return chain
+}
+
+// extractorCause adds the state read error of statedb to a native failure of
+// the observed block, so the observation can tell it from an authoritative
+// rejection.
+func (bc *BlockChain) extractorCause(err error, statedb *state.StateDB) error {
+	if bc.extractorObservation == nil || statedb == nil {
+		return err
+	}
+	if dbErr := statedb.Error(); dbErr != nil {
+		return fmt.Errorf("%w (%w: %w)", err, ErrExtractorParentState, dbErr)
+	}
+	return err
+}
+
+// extractorRewind runs the rewind guard.
+func (bc *BlockChain) extractorRewind(head uint64) error {
+	if ExtractorRewindGuard == nil {
+		return nil
+	}
+	return ExtractorRewindGuard(bc.db, head)
+}
