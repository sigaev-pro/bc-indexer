+// Extractor patch (E01-02.admission, BSC block): the VM safe point.
+
+package vm
+
+import "github.com/ethereum/go-ethereum/core/tracing"
+
+var extractorSafePoint func(*tracing.Hooks, OpCode, *ScopeContext)
+
+// SetExtractorSafePoint installs f, or removes it with nil. The interpreter
+// calls f with the tracer of its EVM, on the native goroutine between VM
+// steps, before the opcode hook and before the opcode changes memory or
+// state, so the owned-capture seam (core/capture) may wait there for its
+// worker. f is never called inside a tracing hook, and only traced execution
+// calls it: prefetchers that clear the tracer never do. The tracer lets f
+// tell the import from other traced executions, such as an RPC trace. Set it
+// before execution starts; it is not synchronized with running interpreters.
+func SetExtractorSafePoint(f func(*tracing.Hooks, OpCode, *ScopeContext)) { extractorSafePoint = f }
