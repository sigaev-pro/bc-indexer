diff --git a/consensus/parlia/extractor.go b/consensus/parlia/extractor.go
new file mode 100644
index 0000000..a84203b
--- /dev/null
+++ b/consensus/parlia/extractor.go
@@ -0,0 +1,78 @@
+// Extractor patch (E01-02.admission, BSC block): Parlia snapshots as logged
+// dependency responses.
+
+package parlia
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/consensus"
+	"github.com/ethereum/go-ethereum/core/types"
+)
+
+// ExtractorSnapshotSource is implemented by the chain reader of an extractor
+// observation. When snapshot receives such a reader, the snapshot is a
+// logged dependency response of the observation: the source runs compute,
+// the native lookup on the native chain (memory cache, stored checkpoint
+// snapshot, header walk), on the first attempt and saves its bytes, and it
+// returns the saved bytes on every later attempt. The bytes are the
+// snapshot's JSON, the encoding of a stored snapshot.
+type ExtractorSnapshotSource interface {
+	ExtractorSnapshot(number uint64, hash common.Hash,
+		compute func(native consensus.ChainHeaderReader) ([]byte, error)) ([]byte, error)
+}
+
+func (p *Parlia) extractorSnapshot(source ExtractorSnapshotSource, number uint64, hash common.Hash,
+	parents []*types.Header) (*Snapshot, error) {
+	blob, err := source.ExtractorSnapshot(number, hash, func(native consensus.ChainHeaderReader) ([]byte, error) {
+		snap, err := p.snapshot(native, number, hash, parents)
+		if err != nil {
+			return nil, err
+		}
+		return json.Marshal(snap)
+	})
+	if err != nil {
+		return nil, err
+	}
+	return p.ExtractorDecodeSnapshot(blob, number, hash)
+}
+
+// ExtractorDecodeSnapshot decodes a snapshot response as loadSnapshot decodes
+// a stored snapshot, and checks that it is the snapshot of the requested
+// block.
+func (p *Parlia) ExtractorDecodeSnapshot(blob []byte, number uint64, hash common.Hash) (*Snapshot, error) {
+	snap := new(Snapshot)
+	if err := json.Unmarshal(blob, snap); err != nil {
+		return nil, err
+	}
+	if snap.Number != number || snap.Hash != hash {
+		return nil, fmt.Errorf("snapshot response of block %d %x, want %d %x", snap.Number, snap.Hash, number, hash)
+	}
+	if snap.EpochLength == 0 {
+		snap.EpochLength = defaultEpochLength
+	}
+	if snap.BlockInterval == 0 {
+		snap.BlockInterval = defaultBlockInterval
+	}
+	if snap.TurnLength == 0 {
+		snap.TurnLength = defaultTurnLength
+	}
+	snap.config, snap.sigCache, snap.ethAPI = p.config, p.signatures, p.ethAPI
+	return snap, nil
+}
+
+// ErrExtractorSystemCall marks a failed system-contract call (ethAPI) on the
+// import path. The calls read the parent state; a failed call is an input
+// failure, not a native decision about the block.
+var ErrExtractorSystemCall = errors.New("parlia: system-contract call failed")
+
+func extractorSystemCall(err error) error {
+	return fmt.Errorf("%w: %w", ErrExtractorSystemCall, err)
+}
+
+// ExtractorHasEthAPI reports whether the engine can make system-contract
+// calls; the import of an epoch or breathe block needs them.
+func (p *Parlia) ExtractorHasEthAPI() bool { return p.ethAPI != nil }
