--- /dev/null
+++ b/core/state/pruner/extractor.go
@@ -0,0 +1,13 @@
+// Extractor patch (E01-02.admission, BSC block).
+
+package pruner
+
+// ExtractorPruningPending reports whether datadir holds the state bloom
+// filter of an interrupted offline prune, found exactly as RecoverPruning
+// finds it. The patched node calls the pin ledger's RecoverPruning, which
+// refuses while a pin is live, only in that case, so a node that holds pins
+// still starts when no prune is pending.
+func ExtractorPruningPending(datadir string) (bool, error) {
+	path, _, err := findBloomFilter(datadir)
+	return path != "", err
+}
