+	// Extractor patch: the pin ledger's PruneState refuses to prune while a
+	// pin is live. It runs the native pruner with 128, the native default of
+	// --triesInMemory, so another value is refused.
+	if tries := ctx.Uint64(utils.TriesInMemoryFlag.Name); tries != 128 {
+		return fmt.Errorf("extractor: prune-state needs --triesInMemory 128, have %d", tries)
 	}
+	var err error
 	if ctx.NArg() > 1 {
 		log.Error("Too many arguments given")
 		return errors.New("too many arguments")
