+// Extractor patch (E01-02.admission, BSC block).
+
+package parlia
+
+// ExtractorResetSnapshots drops the in-memory snapshots, so the next snapshot
+// lookup reads the stored checkpoint snapshot through the engine's database
+// handle and walks the headers above it, as a freshly started engine does.
+// The import seam calls it when an observation begins, so the observation's
+// logged reads do not depend on what earlier imports left in memory.
+func (p *Parlia) ExtractorResetSnapshots() { p.recentSnaps.Purge() }
