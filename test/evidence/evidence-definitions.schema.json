{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence-definitions.schema.json",
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"},
    "commit": {"type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$(?![\\s\\S])"},
    "imageDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$(?![\\s\\S])"},
    "time": {"type": "string", "format": "date-time"},
    "schemaVersion": {"type": "integer", "const": 3},
    "profile": {"enum": ["DOC", "ethereum-mainnet", "ethereum-sepolia", "ethereum-hoodi", "bsc-mainnet", "bsc-testnet", "polygon-pos-mainnet", "polygon-pos-amoy"]},
    "runtimeProfile": {"enum": ["ethereum-mainnet", "ethereum-sepolia", "ethereum-hoodi", "bsc-mainnet", "bsc-testnet", "polygon-pos-mainnet", "polygon-pos-amoy"]},
    "suite": {"enum": ["quick", "functional", "fault", "soak", "public-smoke"]},
    "fixtureKind": {"enum": ["document", "native-seam", "local-e2e", "public"]},
    "executionVerdict": {"enum": ["PASS", "FAIL"]},
    "applicability": {"enum": ["APPLICABLE", "NOT_APPLICABLE", "NOT_ENABLED", "DEFERRED"]},
    "identityProperties": {
      "type": "object",
      "required": ["ac_id", "network", "profile", "profile_manifest_digest", "fork_variant", "fixture_kind", "suite", "variant_id"],
      "properties": {
        "ac_id": {"type": "string", "pattern": "^AC-[A-Z]+-[0-9]{2}-[0-9]{2}$(?![\\s\\S])"},
        "network": {"enum": ["DOC", "ETH", "BSC", "POLY"]},
        "profile": {"$ref": "#/$defs/profile"},
        "profile_manifest_digest": {"anyOf": [{"$ref": "#/$defs/digest"}, {"const": "NOT_APPLICABLE"}]},
        "fork_variant": {"$ref": "#/$defs/text"},
        "fixture_kind": {"$ref": "#/$defs/fixtureKind"},
        "suite": {"$ref": "#/$defs/suite"},
        "variant_id": {"$ref": "#/$defs/text"}
      },
      "allOf": [
        {
          "if": {"properties": {"profile": {"const": "DOC"}}},
          "then": {"properties": {"network": {"const": "DOC"}, "profile_manifest_digest": {"const": "NOT_APPLICABLE"}, "fork_variant": {"const": "NOT_APPLICABLE"}, "fixture_kind": {"const": "document"}}},
          "else": {"properties": {"network": {"enum": ["ETH", "BSC", "POLY"]}, "profile_manifest_digest": {"$ref": "#/$defs/digest"}, "fork_variant": {"not": {"const": "NOT_APPLICABLE"}}, "fixture_kind": {"enum": ["native-seam", "local-e2e", "public"]}}}
        },
        {"if": {"properties": {"profile": {"enum": ["ethereum-mainnet", "ethereum-sepolia", "ethereum-hoodi"]}}}, "then": {"properties": {"network": {"const": "ETH"}}}},
        {"if": {"properties": {"profile": {"enum": ["bsc-mainnet", "bsc-testnet"]}}}, "then": {"properties": {"network": {"const": "BSC"}}}},
        {"if": {"properties": {"profile": {"enum": ["polygon-pos-mainnet", "polygon-pos-amoy"]}}}, "then": {"properties": {"network": {"const": "POLY"}}}},
        {"if": {"properties": {"suite": {"const": "public-smoke"}, "profile": {"not": {"const": "DOC"}}}}, "then": {"properties": {"fixture_kind": {"const": "public"}}}}
      ]
    },
    "identity": {
      "$ref": "#/$defs/identityProperties",
      "properties": {"ac_id": {}, "network": {}, "profile": {}, "profile_manifest_digest": {}, "fork_variant": {}, "fixture_kind": {}, "suite": {}, "variant_id": {}},
      "additionalProperties": false
    },
    "caseProperties": {
      "$ref": "#/$defs/identityProperties",
      "required": ["schema_version", "task_id", "fixture_id", "fixture_version", "applicability"],
      "properties": {
        "schema_version": {"$ref": "#/$defs/schemaVersion"},
        "task_id": {"$ref": "#/$defs/text"},
        "fixture_id": {"$ref": "#/$defs/text"},
        "fixture_version": {"$ref": "#/$defs/text"},
        "applicability": {"$ref": "#/$defs/applicability"},
        "reason": {"$ref": "#/$defs/text"},
        "rule_ref": {"$ref": "#/$defs/text"}
      },
      "if": {"properties": {"applicability": {"enum": ["NOT_APPLICABLE", "NOT_ENABLED", "DEFERRED"]}}},
      "then": {"required": ["reason", "rule_ref"]}
    },
    "registryCase": {
      "$ref": "#/$defs/caseProperties",
      "properties": {"schema_version": {}, "ac_id": {}, "network": {}, "profile": {}, "profile_manifest_digest": {}, "fork_variant": {}, "fixture_kind": {}, "suite": {}, "variant_id": {}, "task_id": {}, "fixture_id": {}, "fixture_version": {}, "applicability": {}, "reason": {}, "rule_ref": {}},
      "additionalProperties": false
    },
    "artifactRef": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {"path": {"$ref": "#/$defs/text"}, "sha256": {"$ref": "#/$defs/digest"}},
      "additionalProperties": false
    },
    "runRef": {
      "type": "object",
      "required": ["path", "sha256", "run_id"],
      "properties": {"path": {"$ref": "#/$defs/text"}, "sha256": {"$ref": "#/$defs/digest"}, "run_id": {"$ref": "#/$defs/text"}},
      "additionalProperties": false
    },
    "artifactList": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/artifactRef"}},
    "textList": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "versionMap": {"type": "object", "additionalProperties": {"$ref": "#/$defs/text"}},
    "buildExclusion": {
      "type": "object", "required": ["reason", "rule_ref"],
      "properties": {"reason": {"$ref": "#/$defs/text"}, "rule_ref": {"$ref": "#/$defs/text"}},
      "additionalProperties": false
    },
    "phase": {
      "type": "object", "required": ["started_at", "finished_at", "deadline_seconds"],
      "properties": {"started_at": {"$ref": "#/$defs/time"}, "finished_at": {"$ref": "#/$defs/time"}, "deadline_seconds": {"type": "number", "exclusiveMinimum": 0}, "duration_seconds": {"type": "number", "minimum": 0}},
      "additionalProperties": false
    },
    "phases": {
      "type": "object", "required": ["preparation", "execution", "teardown"],
      "properties": {"preparation": {"$ref": "#/$defs/phase"}, "execution": {"$ref": "#/$defs/phase"}, "teardown": {"$ref": "#/$defs/phase"}},
      "additionalProperties": {"$ref": "#/$defs/phase"}
    },
    "outcome": {
      "type": "object", "required": ["identity", "verdict"],
      "properties": {"identity": {"$ref": "#/$defs/identity"}, "verdict": {"$ref": "#/$defs/executionVerdict"}, "reason": {"$ref": "#/$defs/text"}},
      "additionalProperties": false
    }
  }
}
