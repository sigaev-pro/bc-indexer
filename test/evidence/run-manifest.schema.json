{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "run-manifest.schema.json",
  "title": "One executed fixture run, evidence schema version 3",
  "type": "object",
  "required": ["schema_version", "run_id", "case_registry_version", "case_registry_digest", "case_identities", "task_id", "fixture_id", "fixture_version", "requirement_ids", "audit_finding_ids", "network", "profile", "profile_manifest_digest", "fork_variant", "fixture_kind", "suite", "native_commits", "patch_commits", "dependency_lock_digest", "compiler_versions", "generator_versions", "image_digests", "architecture", "input_artifacts", "expected_artifacts", "expected_source", "expected_method", "scenario", "seed", "fault_boundary", "storage_model", "cache_model", "run_command", "environment_versions", "case_outcomes", "actual_artifacts", "logs", "comparator_version", "outcome_reason", "started_at", "finished_at", "evidence_producer", "parent_integration_run", "resource_deadline_manifest_digest", "phases"],
  "properties": {
    "schema_version": {"type": "integer", "const": 3},
    "run_id": {"$ref": "evidence-definitions.schema.json#/$defs/text"},
    "case_registry_version": {"$ref": "evidence-definitions.schema.json#/$defs/text"},
    "case_registry_digest": {"$ref": "evidence-definitions.schema.json#/$defs/digest"},
    "case_identities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "evidence-definitions.schema.json#/$defs/identity"}},
    "task_id": {"$ref": "evidence-definitions.schema.json#/$defs/text"},
    "fixture_id": {"$ref": "evidence-definitions.schema.json#/$defs/text"},
    "fixture_version": {"$ref": "evidence-definitions.schema.json#/$defs/text"},
    "requirement_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^REQ-[A-Z]+-[0-9]{2}$(?![\\s\\S])"}},
    "audit_finding_ids": {"$ref": "evidence-definitions.schema.json#/$defs/textList"},
    "network": {"enum": ["DOC", "ETH", "BSC", "POLY"]},
    "profile": {"$ref": "evidence-definitions.schema.json#/$defs/profile"},
    "profile_manifest_digest": {"anyOf": [{"$ref": "evidence-definitions.schema.json#/$defs/digest"}, {"const": "NOT_APPLICABLE"}]},
    "fork_variant": {"$ref": "evidence-definitions.schema.json#/$defs/text"},
    "fixture_kind": {"$ref": "evidence-definitions.schema.json#/$defs/fixtureKind"},
    "suite": {"$ref": "evidence-definitions.schema.json#/$defs/suite"},
    "native_commits": {"type": "object", "additionalProperties": {"$ref": "evidence-definitions.schema.json#/$defs/commit"}},
    "patch_commits": {"type": "object", "additionalProperties": {"$ref": "evidence-definitions.schema.json#/$defs/commit"}},
    "dependency_lock_digest": {"$ref": "evidence-definitions.schema.json#/$defs/digest"},
    "compiler_versions": {"$ref": "evidence-definitions.schema.json#/$defs/versionMap"},
    "generator_versions": {"$ref": "evidence-definitions.schema.json#/$defs/versionMap"},
    "image_digests": {"type": "object", "additionalProperties": {"$ref": "evidence-definitions.schema.json#/$defs/imageDigest"}},
    "build_applicability": {"$ref": "evidence-definitions.schema.json#/$defs/buildExclusion"},
    "architecture": {"$ref": "evidence-definitions.schema.json#/$defs/text"},
    "input_artifacts": {"$ref": "evidence-definitions.schema.json#/$defs/artifactList"},
    "expected_artifacts": {"$ref": "evidence-definitions.schema.json#/$defs/artifactList"},
    "expected_source": {"$ref": "evidence-definitions.schema.json#/$defs/text"},
    "expected_method": {"$ref": "evidence-definitions.schema.json#/$defs/text"},
    "scenario": {"$ref": "evidence-definitions.schema.json#/$defs/text"},
    "seed": {"type": ["integer", "string"], "minLength": 1, "pattern": "\\S"},
    "fault_boundary": {"$ref": "evidence-definitions.schema.json#/$defs/text"},
    "storage_model": {"$ref": "evidence-definitions.schema.json#/$defs/text"},
    "cache_model": {"$ref": "evidence-definitions.schema.json#/$defs/text"},
    "run_command": {"type": "array", "minItems": 1, "items": {"$ref": "evidence-definitions.schema.json#/$defs/text"}},
    "environment_versions": {"$ref": "evidence-definitions.schema.json#/$defs/versionMap", "minProperties": 1},
    "case_outcomes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "evidence-definitions.schema.json#/$defs/outcome"}},
    "actual_artifacts": {"$ref": "evidence-definitions.schema.json#/$defs/artifactList"},
    "logs": {"$ref": "evidence-definitions.schema.json#/$defs/artifactList"},
    "comparator_version": {"$ref": "evidence-definitions.schema.json#/$defs/text"},
    "outcome_reason": {"$ref": "evidence-definitions.schema.json#/$defs/text"},
    "started_at": {"$ref": "evidence-definitions.schema.json#/$defs/time"},
    "finished_at": {"$ref": "evidence-definitions.schema.json#/$defs/time"},
    "evidence_producer": {"$ref": "evidence-definitions.schema.json#/$defs/text"},
    "parent_integration_run": {"anyOf": [{"type": "null"}, {"$ref": "evidence-definitions.schema.json#/$defs/text"}]},
    "resource_deadline_manifest_digest": {"$ref": "evidence-definitions.schema.json#/$defs/digest"},
    "phases": {"$ref": "evidence-definitions.schema.json#/$defs/phases"},
    "run_mode": {"enum": ["standard", "extended"]},
    "correlation_id": {"$ref": "evidence-definitions.schema.json#/$defs/text"},
    "attempt_index": {"enum": [1, 2]},
    "first_run_id": {"$ref": "evidence-definitions.schema.json#/$defs/text"},
    "retry_reason": {"$ref": "evidence-definitions.schema.json#/$defs/text"},
    "correction_ref": {"$ref": "evidence-definitions.schema.json#/$defs/text"}
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"properties": {"profile": {"const": "DOC"}}},
      "then": {"required": ["build_applicability"]},
      "else": {"properties": {"native_commits": {"minProperties": 1}, "compiler_versions": {"minProperties": 1}}}
    },
    {
      "if": {"required": ["attempt_index"], "properties": {"attempt_index": {"const": 2}}},
      "then": {"required": ["first_run_id", "retry_reason"]},
      "else": {"not": {"anyOf": [{"required": ["first_run_id"]}, {"required": ["retry_reason"]}]}}
    }
  ]
}
