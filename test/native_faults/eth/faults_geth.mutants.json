    {
      "name": "corpus into final",
      "file": "test/native_faults/eth/faults_geth.py",
      "original": "final = dict(case.get(\"final\") or {}, corpus=result)",
      "replacement": "final = dict(case.get(\"final\") or {}, corpus=\"PASS\")"
    }
  ]
}
