{
  "schema_version": 1,
  "language": "python",
  "root": "../../..",
  "description": "Single-check mutants of the private ETH type-path judge. Synthetic controls give no native credit.",
  "copy": ["test/type_paths/eth/*", "adapters/geth/admission/native/geth.go"],
  "test": ["{python}", "test/type_paths/eth/test_type_paths_eth.py", "-v"],
  "import": ["eth_type_judge"],
  "timeout_seconds": 30,
  "mutants": [
    {"name": "missing transaction type coverage", "file": "test/type_paths/eth/eth_type_judge.py", "original": "check(len(txs) == 10, \"expected ten transaction observations\")", "replacement": "check(True, \"expected ten transaction observations\")"},
    {"name": "native source identity ignored", "file": "test/type_paths/eth/eth_type_judge.py", "original": "observation.get(\"native_commit\") == NATIVE", "replacement": "True"},
    {"name": "native import error ignored", "file": "test/type_paths/eth/eth_type_judge.py", "original": "case.get(\"import_error\") is None and \"import_error\" in case", "replacement": "True"},
    {"name": "native attach error ignored", "file": "test/type_paths/eth/eth_type_judge.py", "original": "case.get(\"attach_error\") is None and \"attach_error\" in case", "replacement": "True"},
    {"name": "transaction replay differs", "file": "test/type_paths/eth/eth_type_judge.py", "original": "case.get(\"replay_transactions_equal\") is True", "replacement": "True"},
    {"name": "system replay differs", "file": "test/type_paths/eth/eth_type_judge.py", "original": "case.get(\"replay_system_calls_equal\") is True", "replacement": "True"},
    {"name": "root body and gas check removed", "file": "test/type_paths/eth/eth_type_judge.py", "original": "block.get(field) is True", "replacement": "True"},
    {"name": "unresolved decision ignored", "file": "test/type_paths/eth/eth_type_judge.py", "original": "key[:-7] + \"/decided\" in records", "replacement": "True"},
    {"name": "admission ignored", "file": "test/type_paths/eth/eth_type_judge.py", "original": "check(bool(admission), \"no admission records\")", "replacement": "check(True, \"no admission records\")"},
    {"name": "receipt replay ignored", "file": "test/type_paths/eth/eth_type_judge.py", "original": "row.get(\"index\") == i and row.get(\"receipt_equal\") is True", "replacement": "row.get(\"index\") == i"},
    {"name": "transaction status ignored", "file": "test/type_paths/eth/eth_type_judge.py", "original": "tx.get(\"from\") == SENDER and tx.get(\"status\") == expected_status", "replacement": "tx.get(\"from\") == SENDER"},
    {"name": "source bytes ignored", "file": "test/type_paths/eth/eth_type_judge.py", "original": "tx[\"wire\"] == receipt[\"transaction_wire\"] and bool(tx[\"wire\"])", "replacement": "True"},
    {"name": "fee accounting ignored", "file": "test/type_paths/eth/eth_type_judge.py", "original": "quantity(before[SENDER][\"balance\"]) - quantity(after[SENDER][\"balance\"]) ==\n                  gas_fee + blob_fee + expected_status", "replacement": "True"},
    {"name": "target value ignored", "file": "test/type_paths/eth/eth_type_judge.py", "original": "quantity(after[target][\"balance\"]) - quantity(before[target][\"balance\"]) == expected_status", "replacement": "True"},
    {"name": "reverted storage ignored", "file": "test/type_paths/eth/eth_type_judge.py", "original": "before[REVERT][\"slot0\"] == ZERO and after[REVERT][\"slot0\"] == ZERO", "replacement": "True"},
    {"name": "sender nonce ignored", "file": "test/type_paths/eth/eth_type_judge.py", "original": "before[SENDER][\"nonce\"] == index and after[SENDER][\"nonce\"] == index + 1", "replacement": "True"},
    {"name": "authorization state ignored", "file": "test/type_paths/eth/eth_type_judge.py", "original": "before[AUTHORITY][\"nonce\"] == block - 1 and after[AUTHORITY][\"nonce\"] == block and\n                      after[AUTHORITY][\"code\"] == \"ef0100\" + DELEGATE[2:]", "replacement": "True"},
    {"name": "system call coverage ignored", "file": "test/type_paths/eth/eth_type_judge.py", "original": "Counter((row.get(\"block\"), row.get(\"from\"), row.get(\"to\")) for row in calls) ==\n              Counter((block, SYSTEM, target) for block in (1, 2) for target in SYSTEM_TARGETS)", "replacement": "True"},
    {"name": "fork controls incomplete", "file": "test/type_paths/eth/eth_type_judge.py", "original": "[row.get(\"type\") for row in forks] == [1, 2, 3, 4]", "replacement": "True"},
    {"name": "pre fork head advances", "file": "test/type_paths/eth/eth_type_judge.py", "original": "bad.get(\"head\") == 0", "replacement": "True"},
    {"name": "wrong import rejection accepted", "file": "test/type_paths/eth/eth_type_judge.py", "original": "expected_error in (bad.get(\"import_error\") or \"\")", "replacement": "bool(bad.get(\"import_error\"))"},
    {"name": "unknown envelope accepted", "file": "test/type_paths/eth/eth_type_judge.py", "original": "unknown.get(\"unsupported\") is True", "replacement": "True"},
    {"name": "errors still pass", "file": "test/type_paths/eth/eth_type_judge.py", "original": "\"FAIL\" if errors else \"PASS\"", "replacement": "\"PASS\""}
  ]
}
